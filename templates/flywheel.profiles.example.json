    "fable": {
      "harness": "claude-code-pro",
      "model": "claude-fable-5-2",
      "channel": "claude-native",
      "thinking": "high"
    },
    "sol": {
      "harness": "codex-pro",
      "model": "gpt-6.2-sol",
      "channel": "chatgpt-subscription",
      "thinking": "high"
    },
    "sol-plan": {
      "harness": "codex-pro",
      "model": "gpt-6.2-sol",
      "channel": "chatgpt-subscription",
      "thinking": "medium"
    },
    "astra": {
      "harness": "codex-pro",
      "model": "gpt-6.2-astra",
      "channel": "chatgpt-subscription",
      "thinking": "high"
    },
    "kimi": {
      "harness": "kimi",
      "model": "kimi-code/k3.1-pro",
      "channel": "kimi-subscription",
      "thinking": "high",
      "native-profile": "kimi-subscription-agent"
    },
    "orchestrator-neon": {
      "harness": "antigravity",
      "model": "gemini-pro-orchestrator-neon",
      "channel": "google-subscription",
      "thinking": "",
      "native-profile": "antigravity-native"
    },
    "orchestrator-carbon": {
      "harness": "antigravity",
      "model": "gemini-pro-orchestrator",
      "channel": "google-subscription",
      "thinking": "",
      "native-profile": "antigravity-native"
    },
    "orchestrator-argon": {
      "harness": "antigravity",
      "model": "gemini-pro-orchestrator-argon",
      "channel": "google-subscription",
      "thinking": "",
      "native-profile": "antigravity-native"
    },
    "neon-subagents": {
      "harness": "antigravity",
      "model": "gemini-4-neon-high",
      "channel": "google-subscription",
      "thinking": "high",
      "native-profile": "antigravity-subagents"
    },
    "neon-swarm": {
      "harness": "antigravity",
      "model": "gemini-4-neon-high",
      "channel": "google-subscription",
      "thinking": "high",
      "native-profile": "antigravity-swarm"
    },
    "kimi-max": {
      "harness": "kimi",
      "model": "kimi-code/k3.1-pro",
      "channel": "kimi-subscription",
      "thinking": "max",
      "native-profile": "kimi-subscription-agent"
    }
  },
  "planning": {
    "compact": {
      "design-plan": "hydrogen-local",
      "design-review": "sol-plan"
    }
  },
  "judge-panel": null,
  "_note": "One subscription CLI configuration. Native login, model availability and extra-usage controls are checked by each adapter. No API or credits fallback. Existing user permissions are preserved by subscription-cli migration.",
  "native-profiles": {
    "kimi-subscription-agent": {
      "harness": "kimi",
      "options": {
        "version": 1,
        "mode": "agent",
        "agents": {
          "enabled": false
        }
      }
    },
    "antigravity-native": {
      "harness": "antigravity",
      "options": {
        "version": 1,
        "mode": "native",
        "maxObservedAgents": 4
      }
    },
    "antigravity-subagents": {
      "harness": "antigravity",
      "options": {
        "version": 1,
        "mode": "subagents",
        "maxObservedAgents": 4
      }
    },
    "antigravity-swarm": {
      "harness": "antigravity",
      "options": {
        "version": 1,
        "mode": "swarm",
        "maxObservedAgents": 4
      }
    }
  },
