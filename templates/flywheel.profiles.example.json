{
  "version": 1,
  "sessions": {
    "mode": "scoped",
    "policy-version": 1,
    "_note": "会话策略独立于模型 profile；只复用同角色、同作用域且正常终态已确认的历史。旧文件缺省 fresh，显式 Plan resident-session:false 继续生效。"
  },
  "_note": "可选的具名模型配置示例；原 inline 配置继续支持。profile 在加载时展开，阶段字段按是否显式出现覆盖。只选择第一个完整配置文件，不跨任务/项目/全局合并 profiles。",
  "profiles": {
    "flash": {
      "harness": "dsh",
      "model": "deepseek-flash",
      "channel": "deepseek-account-sdk",
      "provider": "deepseek-account",
      "thinking": "high"
    },
    "kimi": {
      "harness": "kimi",
      "model": "kimi-code/k3.1-pro",
      "channel": "kimi-subscription",
      "thinking": "high"
    },
    "gpt-review": {
      "harness": "dsh",
      "model": "gpt-6.1-sol",
      "channel": "chatgpt-sdk",
      "provider": "chatgpt",
      "thinking": "high"
    },
    "gpt-judge": {
      "harness": "dsh",
      "model": "gpt-6-astra",
      "channel": "chatgpt-sdk",
      "provider": "chatgpt",
      "thinking": "high"
    },
    "codex-pro": {
      "harness": "codex-pro",
      "model": "gpt-6.1-sol",
      "channel": "chatgpt-subscription",
      "thinking": "high"
    },
    "claude-sonnet": {
      "harness": "claude-code-pro",
      "model": "sonnet",
      "channel": "claude-subscription",
      "thinking": "high"
    }
  },
  "loops": {
    "plan": { "profile": "kimi", "resident-session": true },
    "review": { "profile": "gpt-review" },
    "judge": { "profile": "gpt-judge" },
    "intake": { "profile": "flash", "thinking": "low" },
    "garden": { "profile": "kimi", "resident-session": false }
  },
  "routes": {
    "default": { "profile": "flash" },
    "frontend": { "profile": "kimi" },
    "hard": { "profile": "codex-pro" }
  },
  "channels": {
    "deepseek-account-sdk": {
      "harness": "dsh",
      "provider": "deepseek-account",
      "env-key": null,
      "_note": "channel 是本配置的渠道别名，provider=deepseek-account 使用 DSH 已登录的 DeepSeek 账号。标准桌面与 SDK 在同一 DSH_HOME 下默认共用账号授权；别名不选择另一账号，也不改用 deepseek-official API key。"
    },
    "chatgpt-sdk": {
      "harness": "dsh",
      "provider": "chatgpt",
      "env-key": null,
      "_note": "SDK profile 需安装并授权 ChatGPT provider；桌面端已登录不等于 SDK 已登录。"
    },
    "kimi-subscription": { "env-key": null },
    "chatgpt-subscription": { "env-key": null },
    "claude-subscription": {
      "env-key": null,
      "_note": "显式可选的 Claude Code Pro 机器接口；需要同一 Node 解析树可见的 dsh-subagent-claude-code-pro@0.4.0、已安装且登录的 claude CLI。此 profile 不绑定默认阶段；原生审批模式不提供 OS 沙箱，首版需 permissions.mode=full-access。"
    }
  },
  "judge-panel": null,
  "budget": { "enforce": "soft", "daily-token-limit": 2000000 },
  "retry": { "jitter": 0.1 },
  "worktree": { "enabled": true },
  "pricing": {},
  "_note_policy": "resident-session 只能写在阶段绑定，不属于模型 profile；sessions 控制同角色历史复用，执行者与评审者始终隔离。thinking 显式空字符串选择 harness 默认值。未知引用、拼错字段、provider 冲突在加载时失败。不自动跨渠道付费降级。",
  "permissions": {
    "mode": "full-access",
    "_note": "全部阶段完全权限、无需逐步审批；旧文件缺省保持 role-based，采用此预设需显式迁移。"
  }
}
