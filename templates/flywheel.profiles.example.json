{
  "jev": {
    "enabled": false,
    "backend": "subscription",
    "profile": "hydrogen-local"
  },
  "version": 1,
  "sessions": {
    "mode": "scoped",
    "policy-version": 1
  },
  "drivers": {
    "plan": "real",
    "execute": "real",
    "review": "real",
    "judge": "real",
    "intake": "real",
    "garden": "real"
  },
  "loops": {
    "design-plan": {
      "profile": "carbon"
    },
    "design-review": {
      "profile": "astra"
    },
    "plan": {
      "profile": "opus-plan"
    },
    "plan-review": {
      "profile": "sol-plan"
    },
    "review": {
      "profile": "sol"
    },
    "judge": {
      "profile": "astra"
    },
    "intake": {
      "profile": "hydrogen-summary"
    },
    "garden": {
      "profile": "kimi"
    },
    "investigate": {
      "profile": "neon"
    }
  },
  "routes": {
    "default": {
      "profile": "hydrogen"
    },
    "complex": {
      "profile": "neon"
    },
    "frontend": {
      "profile": "opus-ui"
    },
    "multimodal": {
      "profile": "opus-ui"
    },
    "backend": {
      "profile": "sol"
    },
    "batch": {
      "profile": "kimi"
    },
    "hard": {
      "profile": "astra"
    }
  },
  "channels": {
    "google-subscription": {
      "harness": "antigravity",
      "env-key": null
    },
    "claude-native": {
      "harness": "claude-code-pro",
      "env-key": null
    },
    "chatgpt-subscription": {
      "harness": "codex-pro",
      "env-key": null
    },
    "kimi-subscription": {
      "harness": "kimi",
      "env-key": null
    }
  },
  "budget": {
    "enforce": "soft",
    "daily-token-limit": 2000000
  },
  "watchdog": {
    "idle-timeout-ms": 300000,
    "wall-timeout-ms": 3600000,
    "kill-grace-ms": 5000,
    "roles": {
      "design-plan": {
        "idle-timeout-ms": 900000
      },
      "design-review": {
        "idle-timeout-ms": 900000
      },
      "plan": {
        "idle-timeout-ms": 900000
      },
      "plan-review": {
        "idle-timeout-ms": 900000
      }
    }
  },
  "retry": {
    "base-delay-ms": 500,
    "max-delay-ms": 10000,
    "jitter": 0.1,
    "max-transport-retries": 5
  },
  "credentials": {
    "poll-interval-ms": 30000,
    "timeout-ms": 86400000
  },
  "intake": {
    "sources": []
  },
  "defect-injection": {
    "every-n-units": 5,
    "test-file-ratio-boost": 0.5,
    "patch": "",
    "test-cmd": ""
  },
  "verify": {
    "command-timeout-ms": 300000,
    "env-allowlist": [],
    "test-file-patterns": [
      "(^|/)(tests?|__tests__|spec)/",
      "\\.(test|spec)\\.[cm]?[jt]sx?$",
      "_test\\.go$",
      "(^|/)test_[^/]+\\.py$"
    ],
    "protected-test-patterns": [],
    "_note": "test-file-patterns 仅用于抽样识别；普通单测可随实现修改。冻结验收必须由 packet.boundaries.must-not-touch 或 protected-test-patterns 显式保护。100% 覆盖率仍由验收命令执行。"
  },
  "scheduler": {
    "mode": "parallel",
    "max-parallel": 2,
    "dispatch": "batch",
    "prewarm": false
  },
  "worktree": {
    "enabled": true
  },
  "pricing": {},
  "permissions": {
    "mode": "full-access",
    "_note": "明确授权全部阶段完全权限与非交互运行；DSH/Codex approval=never，Kimi print=auto。角色职责、契约边界和验收身份仍由Go校验。已有配置未声明时保持role-based，采用本预设需显式迁移。",
    "bindings": {
      "loops.investigate": "read-only"
    }
  },
  "subscription": {
    "version": 1,
    "mode": "subscription-only"
  },
  "profiles": {
    "hydrogen": {
      "harness": "antigravity",
      "model": "gemini-4-hydrogen-high",
      "channel": "google-subscription",
      "thinking": "high"
    },
    "hydrogen-local": {
      "harness": "antigravity",
      "model": "gemini-4-hydrogen-medium",
      "channel": "google-subscription",
      "thinking": "medium"
    },
    "hydrogen-summary": {
      "harness": "antigravity",
      "model": "gemini-4-hydrogen-low",
      "channel": "google-subscription",
      "thinking": "low"
    },
    "neon": {
      "harness": "antigravity",
