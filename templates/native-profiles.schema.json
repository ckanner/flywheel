{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "propertyNames": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
  },
  "additionalProperties": {
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "harness": {
            "const": "dsh"
          },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "version": {
                "const": 1
              },
              "preset": {
                "enum": [
                  "daily",
                  "heavy"
                ]
              },
              "agents": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "maxConcurrent": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "maxDepth": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "team": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "workflows": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "web": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "search": {
                    "type": "boolean"
                  },
                  "fetch": {
                    "type": "boolean"
                  }
                }
              },
              "lcu": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "config": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "app": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "command": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "chrome": {
                        "type": "boolean"
                      },
                      "audio": {
                        "type": "boolean"
                      },
                      "allowedApps": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096
                        },
                        "uniqueItems": true
                      },
                      "allowedOrigins": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096
                        },
                        "uniqueItems": true
                      }
                    }
                  }
                },
                "required": [
                  "enabled"
                ]
              }
            },
            "required": [
              "version",
              "preset"
            ],
            "allOf": [
              {
                "if": {
                  "required": [
                    "team"
                  ],
                  "properties": {
                    "team": {
                      "required": [
                        "enabled"
                      ],
                      "properties": {
                        "enabled": {
                          "const": true
                        }
                      }
                    }
                  }
                },
                "then": {
                  "required": [
                    "agents"
                  ],
                  "properties": {
                    "agents": {
                      "required": [
                        "enabled"
                      ],
                      "properties": {
                        "enabled": {
                          "const": true
                        }
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "workflows"
                  ],
                  "properties": {
                    "workflows": {
                      "required": [
                        "enabled"
                      ],
                      "properties": {
                        "enabled": {
                          "const": true
                        }
                      }
                    }
                  }
                },
                "then": {
                  "required": [
                    "agents"
                  ],
                  "properties": {
                    "agents": {
                      "required": [
                        "enabled"
                      ],
                      "properties": {
                        "enabled": {
                          "const": true
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "required": [
          "harness",
          "options"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "harness": {
            "const": "codex-pro"
          },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "version": {
                "const": 1
              },
              "agents": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "maxConcurrentThreads": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "defaultModel": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "defaultEffort": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "backend": {
                    "enum": [
                      "v2"
                    ]
                  }
                },
                "required": [
                  "enabled"
                ]
              }
            },
            "required": [
              "version"
            ]
          }
        },
        "required": [
          "harness",
          "options"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "harness": {
            "const": "claude-code-pro"
          },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "version": {
                "const": 1
              },
              "agents": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "maxConcurrent": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "maxDepth": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16
                  },
                  "definitions": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "description": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096
                        },
                        "prompt": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096
                        },
                        "tools": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                          },
                          "uniqueItems": true
                        },
                        "disallowedTools": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                          },
                          "uniqueItems": true
                        },
                        "model": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096
                        },
                        "effort": {
                          "enum": [
                            "low",
                            "medium",
                            "high",
                            "xhigh",
                            "max"
                          ]
                        },
                        "permissionMode": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096
                        },
                        "maxTurns": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 1000
                        }
                      },
                      "required": [
                        "description",
                        "prompt"
                      ]
                    }
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "workflows": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "maxConcurrent": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 256
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "advisor": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "enabled"
                ]
              }
            },
            "required": [
              "version"
            ]
          }
        },
        "required": [
          "harness",
          "options"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "harness": {
            "const": "kimi"
          },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "version": {
                "const": 1
              },
              "mode": {
                "enum": [
                  "agent",
                  "swarm",
                  "tower"
                ]
              },
              "agents": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "maxConcurrent": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "tower": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "branch": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                }
              },
              "agentProfile": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "version",
              "mode"
            ]
          }
        },
        "required": [
          "harness",
          "options"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "harness": {
            "const": "antigravity"
          },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "version": {
                "const": 1
              },
              "mode": {
                "enum": [
                  "native",
                  "subagents",
                  "swarm"
                ]
              },
              "maxObservedAgents": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8,
                "description": "Observed total child-ID guard; not a hard concurrency limit."
              }
            },
            "required": [
              "version",
              "mode"
            ]
          }
        },
        "required": [
          "harness",
          "options"
        ]
      }
    ]
  }
}
