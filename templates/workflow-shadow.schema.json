        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "pending",
                  "error"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "advice": {
                "const": "abstain"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "skipped"
              }
            }
          },
          "then": {
            "properties": {
              "advice": {
                "const": "full"
              }
            }
