{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flywheel.local/schemas/workflow-shadow.schema.json",
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "decision-time",
                "prepared",
                "replay",
                "historical",
                "synthetic"
              ]
            },
            "reference": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9._:-]{1,200}$"
            }
          },
          "required": [
            "kind",
            "reference"
          ]
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "maxItems": 32
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "quick",
                "full",
                "unknown"
              ]
            },
            "reason": {
              "type": "string",
              "maxLength": 3000
            }
          },
          "required": [
            "mode",
            "reason"
          ]
        },
        "hard-blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 3000
          },
          "maxItems": 30
        },
        "label": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "enum": [
                    "quick",
                    "full"
                  ]
                },
                "status": {
                  "enum": [
                    "provisional",
                    "confirmed"
                  ]
                },
                "author": {
                  "type": "string",
                  "maxLength": 100
                },
                "reason": {
                  "type": "string",
                  "maxLength": 1000
                }
              },
              "required": [
                "mode",
                "status",
                "author",
                "reason"
              ]
            }
          ]
        }
      },
      "required": [
        "id",
        "source",
        "task",
        "evidence",
        "baseline",
        "hard-blockers"
      ]
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "mode": {
          "const": "shadow"
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/case"
          }
        }
      },
      "required": [
        "version",
        "mode",
        "cases"
      ]
    },
