{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flywheel.local/schemas/preparation-state.schema.json",
  "title": "Bounded investigation state and receipts v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "run-id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$"
    },
    "cwd": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "contract": {
      "$ref": "preparation.schema.json"
    },
    "contract-hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "ready",
        "running",
        "awaiting-report",
        "blocked",
        "supported",
        "inconclusive",
        "access-blocked",
        "cancelled"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "started-at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "deadline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "actions-used": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "output-bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 262144
    },
    "elapsed-ms": {
      "type": "integer",
      "minimum": 0
    },
    "pending": {
      "$ref": "#/$defs/invocation"
    },
    "decision-pending": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "decision-id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$"
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "task-id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$"
            },
            "run-id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$"
            },
            "state-revision": {
              "type": "integer",
              "minimum": 1
            },
            "contract-hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "candidate-hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "observation-hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "task-id",
            "run-id",
            "state-revision",
            "contract-hash",
            "candidate-hash",
            "observation-hash"
          ]
        },
        "facts": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "category": {
                "enum": [
                  "task-summary",
                  "diagnostic-facts",
                  "logs",
                  "source",
                  "diff"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "required": [
              "category",
              "text"
            ]
          }
        },
        "missing-facts": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "actions": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$"
              },
              "kind": {
                "const": "diagnostic"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "binding-hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "id",
              "kind",
              "description",
              "binding-hash"
            ]
          }
        },
        "baseline-id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$"
        },
        "semantic-uncertainty": {
          "type": "boolean"
        },
        "executor-unknown": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "decision-id",
        "identity",
        "facts",
        "missing-facts",
        "actions",
        "baseline-id",
        "semantic-uncertainty",
        "executor-unknown"
      ]
    },
    "observations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "const": 1
          },
          "decision-id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$"
          },
          "backend":{"const":"subscription"},
          "native":{"type":"object","additionalProperties":false,"required":["request-id","dispatch","outcome","cleanup-confirmed","receipt-hash"],"properties":{"request-id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$"},"dispatch":{"enum":["not-dispatched","possible","accepted","dispatched","unknown"]},"outcome":{"enum":["failed","completed","unknown"]},"cleanup-confirmed":{"type":"boolean"},"receipt-hash":{"type":"string","pattern":"^([0-9a-f]{64})?$"}}},
          "snapshot-hash": {
            "type": "string",
            "pattern": "^([0-9a-f]{64})?$"
          },
          "policy-hash": {
            "type": "string",
            "pattern": "^([0-9a-f]{64})?$"
          },
          "target-hash": {
            "type": "string",
            "pattern": "^([0-9a-f]{64})?$"
          },
          "question-hash": {
            "type": "string",
            "pattern": "^([0-9a-f]{64})?$"
          },
          "status": {
            "enum": [
              "ok",
              "skipped",
              "error",
              "unknown"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "action-id": {
            "type": "string",
            "maxLength": 120
          },
          "model": {
            "type": "string",
            "maxLength": 256
          },
          "applicability": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "choice-confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "probabilities": {
            "type": [
              "object",
              "null"
            ],
            "maxProperties": 16,
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "usage": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "input_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "output_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            },
            "required": [
              "input_tokens",
              "output_tokens"
            ]
          },
          "http-status": {
            "type": "integer",
            "minimum": 0,
            "maximum": 599
          },
          "duration-ms": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "version",
          "decision-id",
          "snapshot-hash",
          "policy-hash",
          "target-hash",
          "question-hash",
          "status",
          "reason",
          "action-id",
          "model",
          "applicability",
          "choice-confidence",
          "probabilities",
          "usage",
          "http-status",
          "duration-ms"
        ],
        "allOf": [
          {"if":{"required":["native"]},"then":{"required":["backend"]}},
          {"if":{"properties":{"status":{"const":"skipped"}}},"then":{"not":{"required":["native"]}}},
          {"if":{"required":["backend"],"properties":{"backend":{"const":"subscription"},"status":{"const":"ok"}}},"then":{"required":["native"],"properties":{"http-status":{"const":0},"native":{"properties":{"dispatch":{"const":"accepted"},"outcome":{"const":"completed"},"cleanup-confirmed":{"const":true},"receipt-hash":{"pattern":"^[0-9a-f]{64}$"}}}}}}
        ]
      }
    },
    "decision-started-at": {
      "type": "object",
      "maxProperties": 101,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "report": {
      "$ref": "#/$defs/report"
    },
    "jev-status": {
      "enum": [
        "enabled",
        "disabled",
        "config-unavailable",
        "not-configured",
        "policy-changed"
      ]
    },
    "decision-effects": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "decision-id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$"
          },
          "action-id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$"
          },
          "kind": {
            "enum": [
              "defer",
              "finish"
            ]
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "observations": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "binding-hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "candidate-hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "decision-id",
          "action-id",
          "kind",
          "actions",
          "evidence",
          "observations",
          "binding-hash",
          "candidate-hash",
          "at"
        ]
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/round"
      }
    },
    "analysis-pending": {
      "$ref": "#/$defs/analysis-pending"
    },
    "analysis": {
      "$ref": "#/$defs/analysis-result"
    }
  },
  "required": [
    "version",
    "revision",
    "run-id",
    "cwd",
    "contract",
    "contract-hash",
    "status",
    "reason",
    "started-at",
    "deadline",
    "actions-used",
    "output-bytes",
    "elapsed-ms",
    "observations",
    "decisions"
  ],
  "$defs": {
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "action-id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$"
        },
        "binding-hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate-hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "started-at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "decision-id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$"
        },
        "adopted": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "id",
        "action-id",
        "binding-hash",
        "candidate-hash",
        "started-at",
        "adopted",
        "reason"
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "invocation": {
          "$ref": "#/$defs/invocation"
        },
        "status": {
          "enum": [
            "observed",
            "failed",
            "cancelled",
            "unknown"
          ]
        },
        "output": {
          "type": "string",
          "maxLength": 262144
        },
        "content-hash": {
          "type": "string",
          "pattern": "^([0-9a-f]{64})?$"
        },
        "truncated": {
          "type": "boolean"
        },
        "error": {
          "type": "string",
          "maxLength": 8192
        },
        "finished-at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "duration-ms": {
          "type": "integer",
          "minimum": 0
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "run_command",
                "http_read"
              ]
            },
            "exit-code": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "http-status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "signal": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "timed-out": {
              "type": "boolean"
            },
            "cancelled": {
              "type": "boolean"
            },
            "workspace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "cleanup": {
              "enum": [
                "removed",
                "retained",
                "not-created"
              ]
            },
            "input-hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "kind",
            "timed-out",
            "cancelled",
            "cleanup"
          ]
        }
      },
      "required": [
        "invocation",
        "status",
        "output",
        "content-hash",
        "truncated",
        "finished-at",
        "duration-ms"
      ]
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "supported",
            "inconclusive",
            "access-blocked"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "findings": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "hypothesis": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$"
              },
              "status": {
                "enum": [
                  "supported",
                  "contradicted",
                  "unknown"
                ]
              },
              "evidence": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              }
            },
            "required": [
              "hypothesis",
              "status",
              "evidence",
              "reason"
            ]
          }
        },
        "counter-evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "limitations": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "recommendation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "regression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "rollback": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      },
      "required": [
        "status",
        "summary",
        "findings",
        "counter-evidence",
        "limitations",
        "recommendation",
        "regression",
        "rollback"
      ]
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "number",
        "digest",
        "snapshot"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "snapshot": {
          "allOf": [
            {
              "$ref": "#"
            },
            {
              "not": {
                "required": [
                  "history"
                ]
              }
            }
          ]
        }
      }
    },
    "analysis-request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "run-id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "contract-hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence-hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "harness": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "channel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "thinking": {
              "type": "string",
              "maxLength": 64
            },
            "resident-session": {
              "type": "boolean"
            },
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "native-profile": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "harness",
            "model",
            "channel",
            "thinking"
          ]
        },
        "binding-source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "permission-mode": {
          "enum": [
            "read-only",
            "workspace-write",
            "danger-full-access"
          ]
        },
        "evidence-only": {
          "const": true
        },
        "started-at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "subscription": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "const": 1
            },
            "mode": {
              "const": "subscription-only"
            }
          },
          "required": [
            "version",
            "mode"
          ]
        },
        "native": {
          "type": "object"
        }
      },
      "required": [
        "version",
        "id",
        "run-id",
        "round",
        "revision",
        "contract-hash",
        "evidence-hash",
        "binding",
        "binding-source",
        "permission-mode",
        "evidence-only",
        "started-at"
      ]
    },
    "analysis-pending": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request": {
          "$ref": "#/$defs/analysis-request"
        },
        "native-run-id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "required": [
        "request"
      ]
    },
    "analysis-result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request": {
          "$ref": "#/$defs/analysis-request"
        },
        "receipt-digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recovered": {
          "type": "boolean"
        },
        "finished-at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "duration-ms": {
          "type": "integer",
          "minimum": 0
        },
        "dispatch": {
          "enum": [
            "not-dispatched",
            "dispatched"
          ]
        },
        "outcome": {
          "enum": [
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "cleanup-confirmed": {
          "const": true
        },
        "usage-status": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input": {
              "type": "integer",
              "minimum": 0
            },
            "output": {
              "type": "integer",
              "minimum": 0
            },
            "reasoning": {
              "type": "integer",
              "minimum": 0
            },
            "cacheRead": {
              "type": "integer",
              "minimum": 0
            },
            "cacheWrite": {
              "type": "integer",
              "minimum": 0
            },
            "totalTokens": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "input",
            "output",
            "reasoning",
            "cacheRead",
            "cacheWrite"
          ]
        },
        "cost-usd": {
          "type": "number",
          "minimum": 0
        },
        "report-hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "error": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      },
      "required": [
        "request",
        "receipt-digest",
        "recovered",
        "finished-at",
        "duration-ms",
        "dispatch",
        "outcome",
        "cleanup-confirmed",
        "usage-status"
      ]
    }
  }
}
