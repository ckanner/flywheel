{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flywheel.local/schemas/execution-policy.schema.json",
  "title": "Opt-in bounded execution binding policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "bindings", "routes"],
  "properties": {
    "version": {"const": 1},
    "bindings": {
      "type": "object", "minProperties": 1, "maxProperties": 32,
      "propertyNames": {"pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["harness", "provider", "channel", "model", "thinking", "permission", "session-mode"],
        "properties": {
          "native-profile": { "type": "string", "minLength": 1, "maxLength": 64 },
        "harness": {"enum": ["dsh", "kimi", "codex-pro", "claude-code-pro"]},
          "provider": {"type": "string"},
          "channel": {"type": "string", "pattern": "\\S"},
          "model": {"type": "string", "pattern": "\\S"},
          "thinking": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S", "not": {"pattern": "[\u0000\r\n]"}},
          "permission": {"enum": ["read-only", "workspace-write", "danger-full-access"]},
          "session-mode": {"enum": ["fresh", "scoped"]}
        },
        "allOf": [{
          "if": {"properties": {"harness": {"const": "dsh"}}},
          "else": {"properties": {"thinking": {"enum": ["off", "low", "medium", "high", "xhigh", "max"]}}}
        }]
      }
    },
    "routes": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"enum": ["default", "frontend", "hard", "multimodal"]},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["initial", "allowed", "quality-order", "after-stalled-attempts", "max-switches"],
        "properties": {
          "initial": {"type": "string", "minLength": 1},
          "allowed": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "quality-order": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "channel-fallbacks": {"type": "object", "maxProperties": 32, "additionalProperties": {"type": "string", "minLength": 1}},
          "after-stalled-attempts": {"type": "integer", "const": 1, "description": "Version 1 switches on the first confirmed stalled comparison, before the existing spin stop."},
          "max-switches": {"type": "integer", "minimum": 0, "maximum": 32}
        }
      }
    }
  }
}
