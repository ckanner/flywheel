{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {"type": "boolean"},
    "endpoint": {"type": "string", "maxLength": 2000},
    "model": {"type": "string", "maxLength": 120, "pattern": "^jev-[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "key-env": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,119}$"},
    "timeout-ms": {"type": "integer", "minimum": 1, "maximum": 30000},
    "max-calls": {"type": "integer", "minimum": 1, "maximum": 100},
    "min-applicability": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "min-choice": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "allowed-data": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["task-summary", "diagnostic-facts", "logs", "source", "diff"]}
    }
  }
}
