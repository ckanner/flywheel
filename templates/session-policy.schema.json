{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flywheel.local/schemas/session-policy.schema.json",
  "title": "Flywheel session policy",
  "type": "object",
  "required": ["mode", "policy-version"],
  "properties": {
    "context": {"enum": ["full", "verified-incremental"]},
    "mode": { "type": "string", "enum": ["fresh", "scoped"] },
    "policy-version": { "type": "integer", "const": 1 },
    "roles": {
      "type": "object",
      "properties": {
        "plan": { "$ref": "#/$defs/mode" },
        "design-plan": { "$ref": "#/$defs/mode" },
        "design-review": { "$ref": "#/$defs/mode" },
        "plan-review": { "$ref": "#/$defs/mode" },
        "investigate": { "$ref": "#/$defs/mode" },
        "execute": { "$ref": "#/$defs/mode" },
        "review": { "$ref": "#/$defs/mode" },
        "judge": { "$ref": "#/$defs/mode" },
        "judge-panel": { "$ref": "#/$defs/mode" }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "description": "Explicit measured-workload rebuild limits. Zero disables a limit. No native compression or context capacity is inferred.",
      "properties": {
        "max-confirmed-turns": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "max-unproductive-turns": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "max-run-input-tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "mode": { "type": "string", "enum": ["fresh", "scoped"] }
  },
  "patternProperties": { "^_note(?:_|$)": {} },
  "additionalProperties": false
}
