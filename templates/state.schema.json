{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flywheel.local/schemas/state.schema.json",
  "title": "Flywheel state.json (DESIGN.md §5.2 + v0.8)",
  "description": "Single source of truth, written ONLY by the orchestrator. Agents write done-reports; the orchestrator validates progress and updates the ledger itself. revision is a compare-and-set counter.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema-version", "slug", "revision", "status", "milestones", "packets", "budget", "last-progress-at", "inbox"],
  "allOf": [{
    "if": {"not": {"required": ["planning"]}},
    "then": {"properties": {"preparation-source": {"properties": {"implementation-scope": {"minItems": 1}}}}}
  }],
  "properties": {
    "planning": {"$ref": "planning.schema.json"},
    "worker-prewarm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "id", "scope", "binding", "started-at"],
      "properties": {
        "version": {"const": 1},
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{8,128}$"},
        "scope": {"type": "string", "pattern": "^(final:)?M[0-9]+-T[0-9]+$"},
        "binding": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "started-at": {"type": "string", "minLength": 1},
        "engine-run-id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "runtime-decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "config",
        "used",
        "imported-calls",
        "status",
        "records"
      ],
      "allOf": [{"if":{"properties":{"config":{"required":["backend"],"properties":{"backend":{"const":"subscription"}}}}},"then":{"required":["subscription-binding"]},"else":{"not":{"required":["subscription-binding"]}}}],
      "properties": {
        "subscription-binding":{"type":"object","additionalProperties":false,"required":["profile","harness","channel","model","effort"],"properties":{"profile":{"type":"string","minLength":1,"maxLength":120},"harness":{"const":"antigravity"},"channel":{"type":"string","minLength":1,"maxLength":120},"model":{"type":"string","minLength":1,"maxLength":256},"effort":{"enum":["low","medium","high","xhigh"]}}},
        "version": {
          "const": 1
        },
        "config": {
          "allOf": [
            {
              "$ref": "jev-config.schema.json"
            },
            {
              "type": "object",
              "required": [
                "enabled",
                "timeout-ms",
                "max-calls",
                "min-applicability",
                "min-choice",
                "allowed-data"
              ],
              "allOf": [{"if":{"required":["backend"],"properties":{"backend":{"const":"subscription"}}},"then":{"required":["profile"]},"else":{"required":["endpoint","model","key-env"]}}],
              "properties": {
                "enabled": {
                  "const": true
                }
              }
            }
          ]
        },
        "used": {
          "type": "integer",
          "minimum": 0
        },
        "imported-calls": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "records": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "packet",
              "attempt",
              "plan-revisions",
              "started-at",
              "snapshot",
              "action",
              "status",
              "accounted"
            ],
            "properties": {
              "execution": {
                "type": "object", "additionalProperties": false,
                "required": ["contract-fingerprint"],
                "properties": {
                  "contract-fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "invocation": {
                    "type": "object", "additionalProperties": false,
                    "required": ["id", "started-at", "attempt", "status", "dispatch", "outcome", "cleanup-confirmed"],
                    "properties": {
                      "id": {"type": "string", "pattern": "^call-[A-Za-z0-9]+$"},
                      "engine-run-id": {"type": "string", "minLength": 1, "maxLength": 256},
                      "started-at": {"type": "string", "minLength": 1, "maxLength": 64},
                      "attempt": {"type": "integer", "minimum": 1},
                      "status": {"enum": ["intent", "received", "consumed", "blocked", "abandoned"]},
                      "dispatch": {"enum": ["not-dispatched", "dispatched", "unknown"]},
                      "dispatch-observed": {"type": "boolean"},
                      "outcome": {"enum": ["completed", "failed", "cancelled", "unknown"]},
                      "cleanup-confirmed": {"type": "boolean"}
                    }
                  }
                }
              },
              "model-bindings": {
                "type": "object", "maxProperties": 16,
                "propertyNames": {"pattern": "^model-[0-9]+$"},
                "additionalProperties": {"allOf": [{"$ref": "#/$defs/binding-snapshot"}, {"required": ["bindingId"]}]}
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$"
              },
              "packet": {
                "type": "string",
                "pattern": "^M[0-9]+-T[0-9]+$"
              },
              "attempt": {
                "type": "integer",
                "minimum": 0
              },
              "plan-revisions": {
                "type": "integer",
                "minimum": 0
              },
              "started-at": {
                "type": "string",
                "minLength": 1
              },
              "snapshot": {
                "type": "object"
              },
              "receipt": {
                "type": "object"
              },
              "selection": {
                "type": "object"
              },
              "action": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "pending",
                  "baseline",
                  "applied",
                  "stale",
                  "feedback-running",
                  "feedback-completed",
                  "feedback-unknown",
                  "feedback-stale",
                  "replan-running",
                  "completed"
                ]
              },
              "plan-invocation-before": {
                "type": "string",
                "minLength": 1
              },
              "accounted": {
                "type": "boolean"
              },
              "feedback": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "shared-execution": {"type":"object","additionalProperties":false,"required":["cwd","base-ref","packets"],"properties":{"last-error":{"type":"string","maxLength":2000},"cwd":{"type":"string","minLength":1},"base-ref":{"type":"string","minLength":1},"packets":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"type":"string","pattern":"^M[0-9]+-T[0-9]+$"}}}},
    "project":{"type":"object","additionalProperties":false,"required":["cwd"],"properties":{"workspace-cwd":{"type":"string","minLength":1},"cwd":{"type":"string","minLength":1},"repo":{"type":"string"},"url":{"type":"string"}}},
    "control":{"type":"object","additionalProperties":false,"required":["kind","status","message","started-at"],"properties":{"kind":{"type":"string","minLength":1},"packet":{"type":"string"},"status":{"enum":["running","passed","failed","cancelled"]},"message":{"type":"string","maxLength":2000},"started-at":{"type":"string"},"finished-at":{"type":"string"}}},
    "run":{"type":"object","additionalProperties":false,"required":["id","kind","conditions","startedAt"],"properties":{"initialBindings":{"type":"object","additionalProperties":{"$ref":"#/$defs/binding-snapshot"}},"configurationSource":{"type":"string"},"configurationScope":{"enum":["task","project","global","embedded"]},"bindings":{"type":"object","additionalProperties":{"$ref":"#/$defs/session-configuration"}},"drivers":{"type":"object","additionalProperties":{"type":"string"}},"id":{"type":"string","minLength":1},"kind":{"type":"string"},"conditions":{"type":"string","pattern":"^[0-9a-f]{64}$"},"startedAt":{"type":"string"},"head":{"type":"string"},"branch":{"type":"string"}}},
    "delivery":{"type":"object","additionalProperties":false,"required":["action","repo","head","branch","status","at"],"properties":{"base":{"type":"string","minLength":1},"action":{"enum":["create","merge"]},"repo":{"type":"string","minLength":1},"head":{"type":"string","minLength":1},"branch":{"type":"string","minLength":1},"status":{"enum":["pending","confirmed","unknown"]},"at":{"type":"string"},"url":{"type":"string"},"number":{"type":"integer","minimum":1},"merge-sha":{"type":"string"},"error":{"type":"string"}}},
    "scheduler": {"$ref":"scheduler-policy.schema.json","required":["mode","max-parallel"]},
    "handoff": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "thread", "cwd", "packet", "candidate", "started-at", "reason"],
      "properties": {
        "pending": {"type": "boolean"},
        "previous-invocation": {"type": "string", "pattern": "^call-[A-Za-z0-9]+$"},
        "key": {"type": "string", "minLength": 1},
        "thread": {"type": "string", "minLength": 1},
        "cwd": {"type": "string", "minLength": 1},
        "packet": {"type": "string", "pattern": "^M[0-9]+-T[0-9]+$"},
        "candidate": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "started-at": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "sessions": {
      "type": "object", "additionalProperties": false, "required": ["version", "records"],
      "properties": {
        "version": { "enum": [1, 2, 3, 4] },
        "records": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "additionalProperties": false,
            "required": ["task", "role", "scope", "cwd", "binding", "goal", "contract", "generation", "resume-candidate", "action", "reason", "last"],
            "properties": {
              "configuration": {"$ref":"#/$defs/session-configuration"},
              "task": { "type": "string", "minLength": 1 },
              "role": { "enum": ["plan", "execute", "review", "judge", "judge-panel", "design-plan", "design-review", "plan-review"] },
              "scope": { "type": "string", "minLength": 1 },
              "cwd": { "type": "string", "minLength": 1 },
              "workspace-cwd": { "type": "string", "minLength": 1 },
              "candidate-scope": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
              "binding": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "goal": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "contract": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "generation": { "type": "integer", "minimum": 1 },
              "thread-id": { "type": "string", "minLength": 1 },
              "protocol": { "type": "string", "minLength": 1 },
              "resume-candidate": { "type": "boolean" },
              "action": { "enum": ["create", "resume", "rebuild", "wait", "reconcile", "abandon"] },
              "reason": { "type": "string", "minLength": 1 },
              "quality": {
                "type": "object", "additionalProperties": false,
                "required": ["confirmed-turns", "unproductive-turns", "last-usage-status", "rebuilds"],
                "properties": {
                  "confirmed-turns": { "type": "integer", "minimum": 0 },
                  "unproductive-turns": { "type": "integer", "minimum": 0 },
                  "last-input-tokens": { "type": "integer", "minimum": 0 },
                  "last-usage-status": { "enum": ["complete", "partial", "unknown"] },
                  "last-invocation-id": { "type": "string", "pattern": "^call-[A-Za-z0-9]+$" },
                  "rebuilds": { "type": "integer", "minimum": 0 },
                  "rebuild-reason": { "type": "string", "minLength": 1 }
                }
              },
              "last": {
                "type": "object", "additionalProperties": false,
                "required": ["id", "status", "started-at", "attempt", "candidate-before", "accounted", "dispatch", "outcome", "cleanup-confirmed", "usage-status"],
                "properties": {
                  "id": { "type": "string", "pattern": "^call-[A-Za-z0-9]+$" },
                  "engine-run-id": {"type":"string","minLength":1},
                  "decision-id": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$"},
                  "dispatch-observed": {"type":"boolean"},
                  "status": { "enum": ["intent", "received", "consumed", "blocked", "abandoned"] },
                  "started-at": { "type": "string", "minLength": 1 },
                  "attempt": { "type": "integer", "minimum": 0 },
                  "requested-thread": { "type": "string", "minLength": 1 },
                  "persistent": { "type": "boolean" },
                  "candidate-before": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "candidate-after": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "guard-before": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "guard-after": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "receipt-digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "accounted": { "type": "boolean" },
                  "dispatch": { "enum": ["not-dispatched", "dispatched", "unknown"] },
                  "outcome": { "enum": ["completed", "failed", "cancelled", "unknown"] },
                  "cleanup-confirmed": { "type": "boolean" },
                  "usage-status": { "enum": ["complete", "partial", "unknown"] },
                  "accounting": {
                    "type": "object", "additionalProperties": false,
                    "required": ["day", "provider", "receipt-digest", "usage", "cost-usd"],
                    "properties": {
                      "day": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
                      "provider": { "type": "string", "minLength": 1 },
                      "receipt-digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                      "cost-usd": { "type": ["number", "null"], "minimum": 0 },
                      "usage": {
                        "type": ["object", "null"], "additionalProperties": false,
                        "required": ["input", "output", "reasoning", "cache-read", "cache-write", "total-tokens"],
                        "properties": {
                          "input": { "type": "integer", "minimum": 0 },
                          "output": { "type": "integer", "minimum": 0 },
                          "reasoning": { "type": "integer", "minimum": 0 },
                          "cache-read": { "type": "integer", "minimum": 0 },
                          "cache-write": { "type": "integer", "minimum": 0 },
                          "total-tokens": { "type": "integer", "minimum": 0 }
                        }
                      }
                    }
                  },
                  "abandon": {
                    "type": "object", "additionalProperties": false,
                    "required": ["at", "reason", "authority"],
                    "properties": {
                      "at": { "type": "string", "minLength": 1, "maxLength": 64 },
                      "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
                      "authority": { "const": "human" },
                      "request-id": { "type": "string", "minLength": 1, "maxLength": 120 },
                      "invocation": { "type": "string", "pattern": "^call-[A-Za-z0-9]+$" },
                      "thread-id": { "type": "string", "minLength": 1, "maxLength": 1024 },
                      "source": { "type": "string", "minLength": 1, "maxLength": 1024 }
                    }
                  },
                  "recovery": {
                    "type": "object", "additionalProperties": false,
                    "required": ["version", "harness", "adapter-version", "directory", "model", "effort", "permission-mode", "sequence"],
                    "properties": {
                      "version": { "const": 1 },
                      "harness": { "enum": ["codex-pro", "claude-code-pro", "antigravity"] },
                      "adapter-version": { "type": "string", "minLength": 1 },
                      "directory": { "type": "string", "minLength": 1 },
                      "model": { "type": "string", "minLength": 1 },
                      "effort": { "type": "string", "minLength": 1 },
                      "permission-mode": { "enum": ["read-only", "workspace-write", "danger-full-access"] },
                      "run-id": { "type": "string", "minLength": 1 },
                      "sequence": { "type": "integer", "minimum": 0, "maximum": 64 },
                      "event": { "enum": ["thread-ready", "dispatch-intent", "dispatch-possible", "turn-accepted", "terminal", "cleanup-confirmed"] },
                      "checkpoint-digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                    }
                  }
                },
                "allOf": [{
                  "if": { "properties": { "status": { "enum": ["received", "consumed"] } } },
                  "then": {
                    "required": ["candidate-after", "receipt-digest"],
                    "properties": {
                      "cleanup-confirmed": { "const": true },
                      "dispatch": { "enum": ["not-dispatched", "dispatched"] },
                      "outcome": { "enum": ["completed", "failed", "cancelled"] }
                    }
                  }
                }, {
                  "if": { "properties": { "status": { "const": "abandoned" } } },
                  "then": {
                    "required": ["abandon"],
                    "properties": {
                      "accounted": { "const": true },
                      "cleanup-confirmed": { "const": true }
                    },
                    "anyOf": [
                      { "properties": { "dispatch": { "const": "unknown" } } },
                      { "properties": { "outcome": { "const": "unknown" } } }
                    ]
                  }
                }, {
                  "if": { "required": ["status"], "properties": { "status": { "not": { "const": "abandoned" } } } },
                  "then": { "properties": { "abandon": false } }
                }]
              },
              "context": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "mode",
                  "reason"
                ],
                "properties": {
                  "version": {
                    "const": 1
                  },
                  "identity": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "mode": {
                    "enum": [
                      "full",
                      "incremental"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "allOf": [{
              "if": { "properties": { "resume-candidate": { "const": true } } },
              "then": { "required": ["thread-id", "protocol"] }
            }, {
              "if": { "properties": { "last": { "properties": { "status": { "const": "abandoned" } } } } },
              "then": { "properties": { "resume-candidate": { "const": false } } }
            }]
          }
        }
      }
    },
    "workflow": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "requested", "effective", "reason", "evidence", "risks", "stages", "selected-at", "upgrades"],
      "properties": {
        "version": { "const": 1 },
        "requested": { "enum": ["auto", "quick", "full"] },
        "effective": { "enum": ["quick", "full"] },
        "reason": { "type": "string", "pattern": "\\S" },
        "evidence": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
        "risks": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
        "selected-at": { "type": "string", "minLength": 1 },
        "stages": {
          "type": "object", "additionalProperties": false, "required": ["plan", "judge"],
          "properties": {
            "plan": { "$ref": "#/$defs/workflow-stage" },
            "judge": { "$ref": "#/$defs/workflow-stage" }
          }
        },
        "upgrades": {
          "type": "array", "maxItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["at", "from", "to", "reason", "evidence", "contract-fingerprints"],
            "properties": {
              "at": { "type": "string", "minLength": 1 },
              "from": { "const": "quick" }, "to": { "const": "full" },
              "reason": { "type": "string", "pattern": "\\S" },
              "evidence": { "type": "array", "items": { "type": "string" } },
              "contract-fingerprints": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "effective": { "const": "quick" } } },
          "then": { "properties": {
            "requested": { "enum": ["auto", "quick"] },
            "evidence": { "minItems": 1 }, "risks": { "maxItems": 0 }, "upgrades": { "maxItems": 0 },
            "stages": { "properties": {
              "plan": { "properties": { "applicable": { "const": false } } },
              "judge": { "properties": { "applicable": { "const": false } } }
            } }
          } },
          "else": { "properties": { "stages": { "properties": {
            "plan": { "properties": { "applicable": { "const": true } } },
            "judge": { "properties": { "applicable": { "const": true } } }
          } } } }
        }
      ]
    },
    "schema-version": { "type": "integer", "minimum": 1 },
    "slug": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0, "description": "CAS counter, incremented on every orchestrator write. A stale writer loses." },
    "status": { "type": "string", "enum": ["pending", "running", "paused", "stopped", "completed", "escalated", "budget-stopped"] },
    "current-milestone": { "type": ["string", "null"], "pattern": "^M-\\d{2,}$" },
    "plan-session": {
      "type": ["object", "null"],
      "description": "Resident Kimi CLI session handle. An explicit --session ID resumes only with matching harness, channel, model, cwd and thinking; otherwise rebuild from task contracts.",
      "properties": {
        "session-id": { "type": "string" },
        "channel": { "type": "string" },
        "model": { "type": "string" },
        "harness": { "type": "string" },
        "cwd": { "type": "string" },
        "thinking": { "type": "string" },
        "created-at": { "type": "string" },
        "updated-at": { "type": "string" },
        "resumes": { "type": "integer", "minimum": 0 }
      }
    },
    "milestones": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "plan":{"type":"object","additionalProperties":false,"required":["status","started-at","contracts"],"properties":{"status":{"enum":["running","passed","failed","paused","stale"]},"started-at":{"type":"string"},"finished-at":{"type":"string"},"contracts":{"type":"string"},"error":{"type":"string"},
          "reason": {
            "type": "string"
          },
          "checkpoint": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "milestone",
              "inputs",
              "receipt"
            ],
            "properties": {
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "milestone": {
                "type": "string",
                "pattern": "^M-\\d{2,}$"
              },
              "inputs": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "receipt": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "head": {
                "type": "string",
                "pattern": "^[0-9a-f]{40,64}$"
              }
            }
          }}},
          "status": { "type": "string", "enum": ["pending", "in-progress", "closed"] },
          "gate": {
            "type": ["object", "null"],
            "description": "Milestone gate (L2/L3) outcome + judge verdict (§7 终验), recorded when the milestone closes.",
            "properties": {
              "pass": { "type": "boolean" },
              "levels": { "type": "object" },
              "judge": {
                "type": ["object", "null"],
                "properties": {
                  "verdict": { "type": "string" },
                  "score": { "type": ["number", "null"] },
                  "reasons": { "type": "array" },
                  "error": { "type": "string" },
                  "at": { "type": "string" }
                }
              },
              "at": { "type": "string" }
            }
          },
          "closed-at": { "type": ["string", "null"] },
          "human-guidance": { "type": "string", "maxLength": 2000, "description": "Explicit human milestone triage guidance injected into the next Judge verification." },
          "human-signoff": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "reason", "authority", "source", "candidate"],
            "properties": {
              "at": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "authority": { "const": "human" },
              "source": { "type": "string", "minLength": 1, "maxLength": 500 },
              "candidate": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "packets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["milestone", "status", "route", "attempts", "failed-attempts", "plan-revisions", "interrupted", "retry-history", "evidence"],
        "properties": {
          "schedule": {"$ref":"task-packet.schema.json#/properties/schedule"},
          "parallel": {"type": "boolean"},
          "shared-peers": {"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"type":"string","pattern":"^M[0-9]+-T[0-9]+$"}},
          "milestone": { "type": "string", "pattern": "^M-\\d{2,}$" },
          "status": {
            "type": "string",
            "enum": ["pending", "awaiting-credentials", "executing", "executed", "l1-passed", "l1-failed", "review-failed", "completed", "interrupted", "escalated", "inbox"]
          },
          "route": { "type": "string", "enum": ["frontend", "default", "multimodal", "hard"] },
          "attempts": { "type": "integer", "minimum": 0, "description": "Execute spawns performed." },
          "failed-attempts": { "type": "integer", "minimum": 0, "description": "Attempts that failed. Escalation when failed-attempts >= packet escalation.max-retries." },
          "plan-revisions": {
            "type": "integer",
            "minimum": 0,
            "description": "Times the Plan Loop revised this packet after escalation. >1 consecutive failure rounds goes to inbox."
          },
          "interrupted": {
            "type": "boolean",
            "description": "Set when the orchestrator restarts and finds this unit mid-flight; artifacts are preserved, never silently reset to pending."
          },
          "needs-live-credentials": { "type": "boolean" },
          "artifacts": {
            "type": "array",
            "items": { "type": "string" }
          },
          "exit": {
            "type": ["object", "null"],
            "description": "Exit contract, orthogonally recorded (DESIGN.md §6): a timeout trapped into exit 0 must not read as green.",
            "properties": {
              "exitCode": { "type": ["integer", "null"] },
              "settled": { "type": "boolean" },
              "cancelled": { "type": "boolean" },
              "truncated": { "type": "boolean" },
              "cleanupError": { "type": "string" },
              "signal": { "type": ["string", "null"] },
              "timedOut": { "type": "boolean" },
              "idleTimedOut": { "type": "boolean" },
              "wallTimedOut": { "type": "boolean" }
            }
          },
          "base-ref": {
            "type": ["string", "null"],
            "description": "Git ref recorded before the executor runs; all boundary judgement diffs against it, so executor self-commits cannot drain the diff (§4.2/§4.4). Null when the workspace is not a git checkout."
          },
          "commit": {
            "type": ["object", "null"],
            "description": "Unit-granularity commit made by the orchestrator at completion (§4.2): {sha, message, at} or {skipped|error}.",
            "properties": {
              "sha": { "type": ["string", "null"] },
              "message": { "type": "string" },
              "skipped": { "type": "string" },
              "error": { "type": "string" },
              "at": { "type": "string" }
            }
          },
          "worktree": {
            "type": ["object", "null"],
            "description": "Per-unit git worktree (v0.16 §4.2): {path, branch, mode}. Executor runs inside it when mode=worktree; null when the unit ran in-place (non-git checkout or worktree unavailable).",
            "properties": {
              "path": { "type": "string" },
              "branch": { "type": "string" },
              "mode": { "type": "string", "enum": ["worktree", "in-place"] },
              "external": { "type": "boolean" },
              "reason": { "type": "string" }
            },
            "required": ["path", "branch", "mode"]
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["executor", "l1", "review"],
            "description": "Three evidence levels, different strength: executor self-report < L1 deterministic pass < Review verdict.",
            "properties": {
              "executor": {
                "type": ["object", "null"],
                "properties": {
                  "done-report": { "type": "string" },
                  "report-sha256": { "type": "string" },
                  "requirements-covered": { "type": "array" },
                  "changed-files": { "type": "array" },
                  "failures": { "type": "array" },
                  "at": { "type": "string" }
                }
              },
              "l1": {
                "type": ["object", "null"],
                "properties": {
                  "pass": { "type": "boolean" },
                  "identity": { "type": "string" },
                  "identity-error": { "type": ["string", "null"] },
                  "commands": { "type": "array" },
                  "boundary": { "type": ["object", "null"] },
                  "at": { "type": "string" },
                  "candidate": {
                    "type": "string"
                  },
                  "check-set": {
                    "type": "string"
                  },
                  "environment": {
                    "type": "string"
                  }
                }
              },
              "review": {
                "type": ["object", "null"],
                "properties": {
                  "verdict": { "type": "string", "enum": ["pass", "return", "verification-gap", "upgrade"] },
                  "identity": { "type": "string" },
                  "score": { "type": ["number", "null"] },
                  "reasons": { "type": "array" },
                  "at": { "type": "string" }
                }
              },
              "credentials": {
                "type": ["object", "null"],
                "description": "Live-credentials approval evidence (§9): which env keys a human approved for injection, which were actually present/injected, and when.",
                "properties": {
                  "approved-env": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "injected-env": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "missing-env": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "source": { "type": "string" },
                  "at": { "type": "string" }
                }
              },
              "defect-injection": { "type": ["object", "null"], "description": "Spot-check result (DESIGN.md §4.3), when sampled." },
              "final-gate": { "type": ["object", "null"], "description": "Quick L2/L3 proof bound to the packet candidate and workflow identity before final Review." }
            }
          },
          "last-feedback": {
            "type": ["object", "null"],
            "description": "Previous attempt failure details, supplied to a fresh executor; never counts as current verification evidence."
          },
          "evidence-history": {
            "type": "array",
            "description": "Invalidated evidence snapshots for audit only; never reused as current proof.",
            "items": {
              "type": "object",
              "required": ["at", "evidence"],
              "properties": {
                "at": { "type": "string" },
                "evidence": { "type": "object" }
              }
            }
          },
          "last-failure-signature": { "type": ["string", "null"], "description": "For spin detection: identical consecutive signatures escalate." },
          "retry-history": {
            "type": "array",
            "description": "Every retry is auditable: error code, policy, planned delay (DESIGN.md §6).",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["at", "scope", "error-code", "policy", "planned-delay-ms"],
              "properties": {
                "at": { "type": "string" },
                "scope": { "type": "string", "enum": ["transport", "attempt", "fallback"] },
                "error-code": {
                  "type": "string",
                  "enum": ["AUTH", "QUOTA", "RATE_LIMIT", "SERVER", "TRANSPORT", "TIMEOUT", "EMPTY_RESPONSE", "INVALID_REQUEST", "CONTEXT_WINDOW_EXCEEDED", "L1_FAILED", "REVIEW_RETURNED", "SPIN"]
                },
                "policy": { "type": "string" },
                "planned-delay-ms": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "updated-at": { "type": ["string", "null"] },
          "human-guidance": { "type": "string", "maxLength": 2000, "description": "Explicit human triage scope guidance recorded on inbox retry/replan." },
          "human-signoff": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "reason", "authority", "source", "candidate"],
            "properties": {
              "at": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "authority": { "const": "human" },
              "source": { "type": "string", "minLength": 1, "maxLength": 500 },
              "candidate": { "type": "string", "minLength": 1 }
            }
          },
          "contract-sync-pending": { "type": "boolean", "description": "契约修订尚未同步到保留的工作区，恢复时必须完成同步。" },
          "pending-strategy": {"type":"string","minLength":1},
          "execution-policy": {
            "$ref": "#/$defs/execution-policy-record"
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enforce", "daily-token-limit", "daily", "totals", "cache"],
      "properties": {
        "enforce": { "type": "string", "enum": ["off", "soft", "hard"] },
        "unknown-usage-calls": { "type": "integer", "minimum": 0 },
        "unknown-cost-calls": { "type": "integer", "minimum": 0 },
        "daily-token-limit": { "type": ["integer", "null"] },
        "daily": {
          "type": "object",
          "description": "Per-day token/cost accumulation, keyed by YYYY-MM-DD.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "tokens": { "type": "integer", "minimum": 0 },
              "unknown-usage-calls": { "type": "integer", "minimum": 0 },
              "unknown-cost-calls": { "type": "integer", "minimum": 0 },
              "cost-usd": { "type": "number", "minimum": 0 }
            }
          }
        },
        "totals": {
          "type": "object",
          "properties": {
            "input": { "type": "integer", "minimum": 0 },
            "output": { "type": "integer", "minimum": 0 },
            "reasoning": { "type": "integer", "minimum": 0 },
            "cache-read": { "type": "integer", "minimum": 0 },
            "cache-write": { "type": "integer", "minimum": 0 },
            "tokens": { "type": "integer", "minimum": 0 },
            "calls": { "type": "integer", "minimum": 0 },
            "cost-usd": { "type": "number", "minimum": 0 }
          }
        },
        "cache": {
          "type": "object",
          "description": "Cache hit rate is a first-class engineering metric (DESIGN.md §2 rule 10), tracked per provider.",
          "properties": {
            "hit-rate": { "type": "number", "minimum": 0, "maximum": 1 },
            "by-provider": { "type": "object" }
          }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "last-progress-at": { "type": ["string", "null"], "description": "Timestamp of last validated progress; used for stall/link-death detection (DESIGN.md §6)." },
    "inbox": {
      "type": "array",
      "description": "Escalations addressed to a human.",
      "items": {
        "type": "object",
        "required": ["at", "reason"],
        "properties": {
          "at": { "type": "string" },
          "packet-id": { "type": ["string", "null"] },
          "reason": { "type": "string" }
        }
      }
    },
    "contract-fingerprints": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "当前已加载契约的持久指纹；契约变更使旧完成状态与证据失效。"
    },
    "preparation-source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "run-id",
        "contract-hash",
        "report-hash",
        "implementation-scope",
        "elapsed-ms",
        "actions",
        "accounted"
      ],
      "properties": {
        "round": { "type": "integer", "minimum": 2, "maximum": 33 },
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "run-id": {
          "type": "string",
          "minLength": 1
        },
        "contract-hash": {
          "type": "string",
          "minLength": 1
        },
        "report-hash": {
          "type": "string",
          "minLength": 1
        },
        "implementation-scope": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "elapsed-ms": {
          "type": "integer",
          "minimum": 0
        },
        "actions": {
          "type": "integer",
          "minimum": 0
        },
        "accounted": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "binding-snapshot": {
      "type": "object", "additionalProperties": false, "required": ["binding"],
      "properties": {
        "bindingId": {"type": "string", "minLength": 1, "maxLength": 128},
        "binding": {"$ref": "#/$defs/session-configuration"}
      }
    },
    "input-image-manifest": {
      "type": "object", "additionalProperties": false, "required": ["version", "images"],
      "properties": {
        "version": {"const": 1},
        "images": {"type": "array", "minItems": 1, "maxItems": 4,
          "items": {"type": "object", "additionalProperties": false, "required": ["mimeType", "sha256", "bytes"],
            "properties": {
              "mimeType": {"enum": ["image/png", "image/jpeg", "image/gif", "image/webp"]},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "bytes": {"type": "integer", "minimum": 1, "maximum": 4194304}
            }
          }
        }
      }
    },
    "session-configuration": {"type": "object", "additionalProperties": false, "required": ["harness", "model", "provider", "channel", "thinking", "permission", "sessionMode"], "properties": {"inputImages":{"$ref":"#/$defs/input-image-manifest"}, "subscription": {"type":"object","additionalProperties":false,"required":["version","mode"],"properties":{"version":{"const":1},"mode":{"const":"subscription-only"}}}, "evidenceOnly":{"type":"boolean"}, "nativeProfile": {"type": "string"}, "nativeOptions": {"type": "object", "required": ["version"], "properties": {"version": {"const": 1}}}, "harness": {"type": "string"}, "model": {"type": "string"}, "provider": {"type": "string"}, "channel": {"type": "string"}, "thinking": {"type": "string"}, "permission": {"type": "string"}, "sessionMode": {"type": "string"}}, "allOf":[{"if":{"required":["inputImages"]},"then":{"properties":{"harness":{"enum":["claude-code-pro","antigravity"]}}}}]},
    "workflow-stage": {
      "type": "object", "additionalProperties": false,
      "required": ["applicable", "reason"],
      "properties": {
        "applicable": { "type": "boolean" },
        "reason": { "type": "string", "pattern": "\\S" }
      }
    },
    "execution-policy-record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "identity",
        "route",
        "current",
        "switches",
        "stalled-attempts",
        "last-observed-attempt"
      ],
      "properties": {
        "currentBinding": {
          "allOf": [{"$ref": "#/$defs/binding-snapshot"}, {"required": ["bindingId"]}]
        },
        "version": {
          "const": 1
        },
        "identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "route": {
          "enum": [
            "default",
            "frontend",
            "hard",
            "multimodal",
            "complex",
            "backend",
            "batch"
          ]
        },
        "current": {
          "type": "string",
          "minLength": 1
        },
        "switches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "stalled-attempts": {
          "type": "integer",
          "minimum": 0
        },
        "last-observed-attempt": {
          "type": "integer",
          "minimum": 0
        },
        "history": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "from",
              "to",
              "before",
              "after",
              "reason",
              "at",
              "attempt"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "quality-upgrade",
                  "channel-fallback",
                  "jev-model-selection",
                  "jev-initial-selection"
                ]
              },
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "before": {
                "$ref": "#/$defs/session-configuration"
              },
              "after": {
                "$ref": "#/$defs/session-configuration"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "at": {
                "type": "string",
                "minLength": 1
              },
              "attempt": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
