{
  "name": "dsh-subagent-antigravity",
  "version": "0.1.0",
  "description": "DSH Antigravity tasks through the official agy CLI, with subscription checks and durable lifecycle receipts",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./machine": {
      "types": "./lib/machine.d.ts",
      "import": "./lib/machine.js"
    },
    "./client": "./assets/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "antigravity-machine": "./bin/antigravity-machine.js"
  },
  "files": [
    "lib",
    "bin",
    "assets",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:package": "node scripts/test-package.js",
    "test:host-install": "node scripts/test-host-install.js",
    "check": "npm test && npm run test:package"
  },
  "engines": {
    "node": ">=22.18.0",
    "dsh": ">=0.2.2-rc.3 <0.4.0-0"
  },
  "dependencies": {
    "ajv": "8.17.1"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tool-executor-ptc": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^22.20.5",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "typescript": "5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ckanner/flywheel.git",
    "directory": "plugins/antigravity"
  },
  "publishConfig": {
    "access": "public"
  }
}
