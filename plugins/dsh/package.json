    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.3",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.3",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.3",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "dompurify": "^3.5.0",
    "dsh-plugin-chatgpt": "file:vendor/dsh-plugin-chatgpt-0.1.20.tgz",
    "dsh-plugin-lcu": "file:vendor/dsh-plugin-lcu-0.5.0.tgz",
    "dsh-subagent-claude-code-pro": "file:vendor/dsh-subagent-claude-code-pro-0.7.1.tgz",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "jsdom": "26.1.0",
    "lightningcss": "1.33.0",
    "marked": "^18.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "semver": "7.7.3",
    "streamdown": "^2.8.1",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ckanner/flywheel.git",
    "directory": "plugins/dsh"
  },
  "bundledDependencies": [
    "dsh-subagent-codex-pro",
    "dsh-preset-generator",
