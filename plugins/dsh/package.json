{
  "name": "@ckanner/dsh-plugin-flywheel",
  "version": "0.28.5",
  "description": "Flywheel engine controls with owned DSH SDK, Codex Pro and optional Claude Code Pro machine workers",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18.0",
    "dsh": "0.2.1-rc.5 || 0.2.2-rc.1"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./worker-policy": "./dist/policy.js",
    "./worker": "./dist/worker.js",
    "./codex-pro-worker": "./dist/codex-pro-worker.js",
    "./package.json": "./package.json",
    "./claude-code-pro-worker": "./dist/claude-code-pro-worker.js"
  },
  "bin": {
    "flywheel-dsh-worker": "./dist/worker.js",
    "flywheel-codex-pro-worker": "./dist/codex-pro-worker.js",
    "flywheel-claude-code-pro-worker": "./dist/claude-code-pro-worker.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "PROTOCOL.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5 || ~4.1.0",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.5 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.5 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5 || 0.2.2-rc.1",
    "dsh-subagent-claude-code-pro": "0.3.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "dsh-subagent-claude-code-pro": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.js && node scripts/test-legacy-host.mjs",
    "check": "npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "dsh-subagent-codex-pro": "0.8.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sdk-jsonrpc-server": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-ptc": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "jsdom": "26.1.0",
    "lightningcss": "1.33.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "semver": "7.7.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ckanner/flywheel.git",
    "directory": "plugins/dsh"
  }
}
