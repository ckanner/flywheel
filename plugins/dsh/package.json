{
  "name": "@ckanner/flywheel",
  "version": "0.41.0",
  "description": "Flywheel engine controls with owned DSH SDK, Codex Pro and optional Claude Code Pro machine workers",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0",
    "dsh": ">=0.2.1-rc.5 <0.4.0-0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./worker-policy": "./dist/policy.js",
    "./worker": "./dist/worker.js",
    "./codex-pro-worker": "./dist/codex-pro-worker.js",
    "./package.json": "./package.json",
    "./claude-code-pro-worker": "./dist/claude-code-pro-worker.js",
    "./kimi-native-worker": "./dist/kimi-native-worker.js",
    "./native-jobs": "./dist/native-jobs.js",
    "./antigravity-worker": "./dist/antigravity-worker.js",
    "./model-catalog-worker": "./dist/model-catalog-worker.js"
  },
  "bin": {
    "flywheel-dsh-worker": "./dist/worker.js",
    "flywheel-codex-pro-worker": "./dist/codex-pro-worker.js",
    "flywheel-claude-code-pro-worker": "./dist/claude-code-pro-worker.js",
    "flywheel-kimi-native-worker": "./dist/kimi-native-worker.js",
    "flywheel-antigravity-worker": "./dist/antigravity-worker.js",
    "flywheel-model-catalog": "./dist/model-catalog-worker.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "PROTOCOL.md",
    "THIRD_PARTY_NOTICES.md",
    "vendor/README.md",
    "vendor/codex-pro.json",
    "LICENSE",
    "README.zh-CN.md",
    "vendor/preset-generator.json",
    "vendor/claude-code-pro.json",
    "vendor/lcu.json",
    "vendor/chatgpt.json",
    "vendor/antigravity.json",
    "vendor/registry-verification-2026-11-22.json",
    "KIMI_NATIVE_PROTOCOL.md",
    "KIMI_NATIVE_PROTOCOL.en.md",
    "vendor/ckanner-dsh-subagent-antigravity-0.3.1.tgz"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5 || ~4.1.0",
    "@deepseek-ai/dsh-commands": ">=0.2.1-rc.5 <0.4.0-0 || ^0.2.2-0 || ^0.2.3-0 || ^0.3.0-0",
    "@deepseek-ai/dsh-session-projection": ">=0.2.1-rc.5 <0.4.0-0 || ^0.2.2-0 || ^0.2.3-0 || ^0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.4.0-0 || ^0.2.2-0 || ^0.2.3-0 || ^0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.5 <0.4.0-0 || ^0.2.2-0 || ^0.2.3-0 || ^0.3.0-0",
    "dsh-plugin-lcu": "0.5.0 || 0.5.1",
    "dsh-subagent-claude-code-pro": "0.7.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "dsh-subagent-claude-code-pro": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "dsh-plugin-lcu": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.client.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.js && node scripts/test-legacy-host.mjs",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
