{
  "name": "@ckanner/dsh-plugin-flywheel",
  "version": "0.27.2",
  "description": "Flywheel engine controls and an owned native DSH SDK worker",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "dsh": "0.2.1-rc.5"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./worker-policy": "./dist/policy.js",
    "./worker": "./dist/worker.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "flywheel-dsh-worker": "./dist/worker.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "PROTOCOL.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.js",
    "check": "npm test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ckanner/flywheel.git",
    "directory": "plugins/dsh"
  }
}
