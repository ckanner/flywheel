{
  "name": "@ckanner/flywheel",
  "version": "0.31.0",
  "description": "A deterministic Go orchestrator for coding-agent loops, with task contracts, verification gates, Git worktrees, and DSH desktop integration.",
  "bin": {
    "flywheel": "bin/flywheel.js",
    "flywheel-dsh-worker": "bin/flywheel-dsh-worker.js",
    "flywheel-codex-pro-worker": "bin/flywheel-codex-pro-worker.js",
    "flywheel-claude-code-pro-worker": "bin/flywheel-claude-code-pro-worker.js"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ckanner/flywheel.git"
  },
  "license": "UNLICENSED",
  "files": [
    "bin",
    "npm/*.js",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs/getting-started.md",
    "docs/configuration.md",
    "docs/model-policy.md",
    "docs/workflow.md",
    "docs/flow-console.md",
    "docs/en/getting-started.md",
    "docs/en/configuration.md",
    "docs/en/model-policy.md",
    "docs/en/workflow.md",
    "docs/en/flow-console.md",
    "docs/examples/create-first-task.sh",
    "docs/claude-code-pro.md",
    "docs/en/claude-code-pro.md",
    "docs/session-recovery.md",
    "docs/en/session-recovery.md",
    "docs/session-evaluation.md",
    "docs/en/session-evaluation.md"
  ],
  "optionalDependencies": {
    "@ckanner/flywheel-darwin-arm64": "0.31.0",
    "@ckanner/flywheel-darwin-amd64": "0.31.0",
    "@ckanner/flywheel-linux-arm64": "0.31.0",
    "@ckanner/flywheel-linux-amd64": "0.31.0"
  },
  "scripts": {
    "release:check": "node scripts/release-preflight.js",
    "release:local": "node scripts/release-local.js",
    "test": "node --test npm/test/*.test.js",
    "test:install": "node --test npm/test/install.integration.js",
    "test:registry": "node npm/test/registry-smoke.js",
    "build:npm": "bash scripts/build-npm.sh 0.31.0 dist-npm",
    "test:sessions": "node scripts/test-session-evaluation.js"
  },
  "dependencies": {
    "@ckanner/dsh-plugin-flywheel": "0.31.0"
  }
}
